{
  "name": "vibecraft-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "start:prod": "next start -p 3000 -H 0.0.0.0",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
