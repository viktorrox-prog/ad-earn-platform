    "@tailwindcss/postcss": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.0",
    "lucide-react": "^0.454.0",
    "next": "15.1.6",
    "next-themes": "^0.3.0",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
