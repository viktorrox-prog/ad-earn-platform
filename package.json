    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0"
